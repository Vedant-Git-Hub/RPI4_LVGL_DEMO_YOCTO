From: Vedant Bhale <vedant.bhale@ymail.com>
Subject: [PATCH] SDL: require an accelerated renderer for video presentation
Upstream-Status: Inappropriate [appliance-specific display fallback]
Signed-off-by: Vedant Bhale <vedant.bhale@ymail.com>

The video app falls back to fbdev if KMSDRM cannot provide a GPU renderer.

--- a/src/drivers/sdl/lv_sdl_window.c
+++ b/src/drivers/sdl/lv_sdl_window.c
@@ -47,7 +47,7 @@
  *  STATIC PROTOTYPES
  **********************/
 static void flush_cb(lv_display_t * disp, const lv_area_t * area, uint8_t * color_p);
-static void window_create(lv_display_t * disp);
+static int window_create(lv_display_t * disp);
 static void window_update(lv_display_t * disp);
 #if LV_USE_DRAW_SDL == 0
     static void texture_resize(lv_display_t * disp);
@@ -84,7 +84,10 @@
 lv_display_t * lv_sdl_window_create(int32_t hor_res, int32_t ver_res)
 {
     if(!inited) {
-        SDL_Init(SDL_INIT_VIDEO);
+        if(SDL_Init(SDL_INIT_VIDEO) < 0) {
+            fprintf(stderr, "SDL video initialization failed: %s\n", SDL_GetError());
+            return NULL;
+        }
         SDL_StartTextInput();
         event_handler_timer = lv_timer_create(sdl_event_handler, 5, NULL);
         lv_tick_set_cb(SDL_GetTicks);
@@ -110,7 +113,11 @@
     }
     lv_display_add_event_cb(disp, release_disp_cb, LV_EVENT_DELETE, disp);
     lv_display_set_driver_data(disp, dsc);
-    window_create(disp);
+    if(window_create(disp) < 0) {
+        lv_display_delete(disp);
+        lv_sdl_quit();
+        return NULL;
+    }
 
     lv_display_set_flush_cb(disp, flush_cb);
 
@@ -294,7 +301,7 @@
     }
 }
 
-static void window_create(lv_display_t * disp)
+static int window_create(lv_display_t * disp)
 {
     lv_sdl_window_t * dsc = lv_display_get_driver_data(disp);
     dsc->zoom = 1;
@@ -310,7 +317,20 @@
                                    SDL_WINDOWPOS_UNDEFINED, SDL_WINDOWPOS_UNDEFINED,
                                    hor_res * dsc->zoom, ver_res * dsc->zoom, flag);       /*last param. SDL_WINDOW_BORDERLESS to hide borders*/
 
-    dsc->renderer = SDL_CreateRenderer(dsc->window, -1, SDL_RENDERER_SOFTWARE);
+    if(!dsc->window) {
+        fprintf(stderr, "SDL window creation failed: %s\n", SDL_GetError());
+        return -1;
+    }
+
+    dsc->renderer = SDL_CreateRenderer(dsc->window, -1,
+                                       SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC);
+    if(!dsc->renderer) {
+        fprintf(stderr, "SDL accelerated renderer unavailable: %s\n", SDL_GetError());
+        return -1;
+    }
+    SDL_RendererInfo info;
+    if(SDL_GetRendererInfo(dsc->renderer, &info) == 0)
+        fprintf(stderr, "photo-viewer: accelerated SDL renderer %s\n", info.name);
 #if LV_USE_DRAW_SDL == 0
     texture_resize(disp);
 
@@ -325,6 +345,11 @@
 #if LV_USE_DRAW_SDL == 0
     texture_resize(disp);
+    if(!dsc->texture) {
+        fprintf(stderr, "SDL video texture unavailable: %s\n", SDL_GetError());
+        return -1;
+    }
 #endif /*LV_USE_DRAW_SDL == 0*/
+    return 0;
 }
 
 static void window_update(lv_display_t * disp)
